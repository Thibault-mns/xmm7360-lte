#!/bin/bash
# Coupe la liaison LTE du modem XMM7360.
# Les scripts RPC ne savent pas detacher le modem du reseau : le
# dechargement du module iosm est le seul moyen fiable de le faire, et il
# a l'avantage de couper l'alimentation de la radio.
set -u

ip link set wwan0 down 2>/dev/null || true
ip addr flush dev wwan0 2>/dev/null || true
modprobe -r iosm 2>/dev/null || true

# modprobe -r echoue silencieusement si le module est occupe : verifier,
# sinon on annoncerait une radio coupee alors qu'elle emet encore.
if lsmod | grep -q '^iosm '; then
    echo "xmm7360: ATTENTION, le module iosm n'a pas pu etre decharge" >&2
    exit 1
fi

echo "xmm7360: deconnecte (module iosm decharge)"
