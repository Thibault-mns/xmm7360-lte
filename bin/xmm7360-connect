#!/bin/bash
# Etablit la connexion LTE du modem Intel XMM7360 / Fibocom L850-GL
# par-dessus le pilote noyau iosm (le modem est en mode RPC, que
# ModemManager ne sait pas piloter).
set -u

if [ "$(id -u)" -ne 0 ]; then
    echo "xmm7360: ce script doit tourner en root — passez par" >&2
    echo "  systemctl start xmm7360   (ou sudo $0)" >&2
    exit 1
fi

REPO="${XMM7360_REPO:-/home/thibault/xmm7360-pci}"
SCRIPT="$REPO/rpc/open_xdatachannel.py"
CONF="$REPO/xmm7360.ini"
RPC_DEV=/dev/wwan0xmmrpc0
LOG=/var/log/xmm7360.log

log() { echo "xmm7360: $*"; }

has_ip() { ip -4 addr show wwan0 2>/dev/null | grep -q 'inet '; }

wait_for_rpc() {
    local secs="$1"
    for _ in $(seq 1 "$secs"); do
        [ -e "$RPC_DEV" ] && return 0
        sleep 1
    done
    return 1
}

# La veille S3 fige le modem : au reveil, iosm se charge et s'attache mais
# le peripherique ne repond plus et aucun port wwan n'est cree. Recharger
# le module ne suffit pas — seul un remove/rescan PCI reinitialise
# reellement le peripherique.
# Bascule la gestion d'energie de tous les ponts PCIe (on / auto).
bridges_power() {
    local p
    for p in /sys/bus/pci/devices/*; do
        [ "$(cat "$p/class" 2>/dev/null)" = "0x060400" ] \
            && echo "$1" > "$p/power/control" 2>/dev/null
    done
    return 0
}

pci_cycle() {
    local dev found=""
    for dev in /sys/bus/pci/devices/*; do
        if [ "$(cat "$dev/vendor" 2>/dev/null)" = "0x8086" ] \
           && [ "$(cat "$dev/device" 2>/dev/null)" = "0x7360" ]; then
            found=$(basename "$dev")
            log "reinitialisation PCI du modem ($found)"
            echo 1 > "$dev/remove"
            sleep 2
            break
        fi
    done
    [ -n "$found" ] || log "modem absent du bus PCI, rescan a l'aveugle"
    # Reveiller les ponts PCIe avant le rescan : un pont descendu en D3cold
    # apres le retrait n'est pas re-enumere, et le modem disparait alors
    # definitivement du bus jusqu'au prochain demarrage a froid.
    bridges_power on
    sleep 1
    echo 1 > /sys/bus/pci/rescan
    sleep 3
    bridges_power auto
}

ensure_device() {
    [ -e "$RPC_DEV" ] && return 0
    modprobe iosm 2>/dev/null || true
    wait_for_rpc 10 && return 0
    log "ports absents malgre le module charge : cycle PCI"
    modprobe -r iosm 2>/dev/null || true
    pci_cycle
    modprobe iosm 2>/dev/null || true
    wait_for_rpc 20
}

# Un seul log par session de connexion, les deux tentatives a la suite :
# tronquer dans connect() effacerait la premiere, la seule qui explique
# pourquoi un rechargement du module a ete necessaire.
: >"$LOG"

connect() {
    ensure_device || { log "$RPC_DEV absent malgre le cycle PCI"; return 1; }
    # Pas d'IPv6 sur la 4G : le tunnel WireGuard n'achemine que
    # l'IPv4, et toute IPv6 obtenue par SLAAC sortirait DIRECTEMENT par
    # l'operateur, en contournant le VPN (fuite + rejet par les services
    # qui whitelistent les IP, le prefixe mobile changeant sans cesse).
    # A faire avant la montee du lien, sinon le SLAAC gagne la course.
    # Commenter ces deux lignes pour retrouver l'IPv6 operateur.
    sysctl -qw net.ipv6.conf.wwan0.disable_ipv6=1 2>/dev/null || true
    ip -6 addr flush dev wwan0 2>/dev/null || true
    echo "=== tentative $(date -Is) ===" >>"$LOG"
    # Le script sort en code 1 meme en cas de succes (sys.exit(1) final) et
    # en 0 quand l'ouverture RPC echoue : son code de retour n'est pas
    # exploitable, on juge sur la presence d'une adresse IP.
    # Borne dure : quand le modem s'attache sans obtenir d'IP (demarrage a
    # froid), open_xdatachannel.py boucle sans fin — sans timeout, le second
    # essai avec rechargement du module n'aurait jamais sa chance et l'unite
    # resterait "activating" jusqu'au TimeoutStartSec de systemd.
    timeout --kill-after=10 90 python3 "$SCRIPT" -c "$CONF" >>"$LOG" 2>&1 || true
    has_ip
}

# Declare aupres de systemd-resolved les DNS que le reseau mobile a fournis
# (le script python les journalise) : sans cela, la resolution en 4G seule
# retombe sur les serveurs de secours generiques de resolved. Best effort :
# une distribution sans resolved fonctionne quand meme, via ces secours.
setup_dns() {
    local dns
    dns=$(grep "DNS server(s):" "$LOG" | tail -1 | sed 's/.*: //; s/,//g')
    [ -n "$dns" ] || return 0
    # shellcheck disable=SC2086
    resolvectl dns wwan0 $dns 2>/dev/null \
        && resolvectl default-route wwan0 true 2>/dev/null \
        && log "DNS declares sur wwan0 : $dns" \
        || log "resolvectl indisponible, DNS de secours de resolved utilises"
}

if connect; then
    setup_dns
    log "connecte : $(ip -4 -br addr show wwan0)"
    exit 0
fi

# Au reveil de veille le modem est eteint : un cycle complet du module le
# remet dans un etat propre.
log "pas d'IP au premier essai, reinitialisation complete du modem"
modprobe -r iosm || true
pci_cycle
modprobe iosm || { log "echec du chargement de iosm"; exit 1; }
sleep 3

if connect; then
    setup_dns
    log "connecte apres rechargement : $(ip -4 -br addr show wwan0)"
    exit 0
fi

log "echec : pas d'adresse IP sur wwan0 (details dans $LOG)"
exit 1
